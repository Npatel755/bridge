# Optional. Without LLM_API_KEY, Ask/Team/Extract use the deterministic engine (labeled in the UI).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
# Optional LinkedIn OAuth (Sign in with LinkedIn / OpenID). Only verifies your own profile; connections are not exposed by the API.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
