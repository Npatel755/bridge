# Copy to apps/mobile/.env (client) and supabase/functions/.env (server). See README.md.
# --- Client (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# --- Edge Functions (supabase/functions/.env) --- all optional
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
